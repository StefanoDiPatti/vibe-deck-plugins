{"format":1,"files":{"lang/en.json":{"$rules":[["^uso (.+)$","usage $1"],["^(\\d+)% usata$","$1% used"]]},"plugin.json":{"id":"sistema","name":"System","version":"1.0.0","author":"StefanoDiPatti","description":"More data of the PC: CPU and GPU temperature, download and upload speed, free RAM, video memory","type":"plugin","platforms":["windows","linux"],"engine":">=2.2.0","tags":["system"]},"widgets/download.json":{"name":"Download","description":"Velocità di download adesso","icon":"down","shape":"value","source":{"type":"pc"},"every":2,"show":{"label":"DOWNLOAD","icon":"down","value":"{{net.downMbps|round:1}}","unit":"Mbps","sub":"{{net.name}}"},"size":{"w":2,"h":1}},"widgets/ram-libera.json":{"name":"RAM usata","description":"Memoria usata e totale","icon":"cpu","shape":"value","source":{"type":"pc"},"every":5,"show":{"label":"RAM","icon":"cpu","value":"{{ram.usedGb}}","unit":"/ {{ram.totalGb}} GB","sub":"{{ram.usage}}% usata","bar":"{{ram.usage}}","warn":75,"hot":90},"size":{"w":2,"h":1}},"widgets/temperatura-cpu.json":{"name":"Temperatura CPU","description":"La temperatura del processore (se il PC la fornisce)","icon":"thermo","shape":"value","source":{"type":"pc"},"every":3,"show":{"label":"CPU","icon":"thermo","value":"{{cpu.temp|default:N/D}}","unit":"°C","sub":"uso {{cpu.usage}}%","bar":"{{cpu.temp}}","warn":70,"hot":85},"size":{"w":2,"h":1}},"widgets/temperatura-gpu.json":{"name":"Temperatura GPU","description":"La temperatura della scheda video (serve nvidia-smi)","icon":"thermo","shape":"value","source":{"type":"pc"},"every":3,"show":{"label":"GPU","icon":"thermo","value":"{{gpu.temp|default:N/D}}","unit":"°C","sub":"uso {{gpu.usage|default:–}}%","bar":"{{gpu.temp}}","warn":70,"hot":85},"size":{"w":2,"h":1}},"widgets/upload.json":{"name":"Upload","description":"Velocità di upload adesso","icon":"up","shape":"value","source":{"type":"pc"},"every":2,"show":{"label":"UPLOAD","icon":"up","value":"{{net.upMbps|round:1}}","unit":"Mbps","sub":"{{net.name}}"},"size":{"w":2,"h":1}},"widgets/vram.json":{"name":"Memoria video","description":"Memoria della scheda video usata (serve nvidia-smi)","icon":"cpu","shape":"value","source":{"type":"pc"},"every":5,"show":{"label":"VRAM","icon":"cpu","value":"{{gpu.memUsedGb|default:N/D}}","unit":"/ {{gpu.memTotalGb|default:–}} GB","sub":"{{gpu.name|default:scheda video}}"},"size":{"w":2,"h":1}}}}