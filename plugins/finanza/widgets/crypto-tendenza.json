{
  "name": "Crypto di tendenza",
  "description": "Le monete più cercate su CoinGecko nelle ultime 24 ore",
  "icon": "bolt",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://api.coingecko.com/api/v3/search/trending"
  },
  "every": 1800,
  "show": {
    "label": "CRYPTO DI TENDENZA",
    "items": "{{coins}}",
    "max": 10,
    "item": {
      "icon": "bolt",
      "title": "{{item.item.name}} · {{item.item.symbol}}",
      "sub": "posizione {{item.item.market_cap_rank|default:–}}",
      "right": "{{item.item.data.price_change_percentage_24h.usd|round:1}}%"
    }
  },
  "tap": {
    "type": "open_url",
    "url": "https://www.coingecko.com/it/monete/{{item.item.id|url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
