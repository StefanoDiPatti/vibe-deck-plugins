{
  "name": "Crypto: Bitcoin ed Ethereum",
  "description": "Due righe con prezzo in euro e variazione nelle 24 ore",
  "icon": "bolt",
  "shape": "bars",
  "source": { "type": "http", "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=eur&include_24hr_change=true" },
  "every": 120,
  "show": {
    "label": "CRYPTO",
    "rows": [
      { "label": "BTC", "value": "{{bitcoin.eur|round|thousands}} € · {{bitcoin.eur_24h_change|round:1}}%" },
      { "label": "ETH", "value": "{{ethereum.eur|round|thousands}} € · {{ethereum.eur_24h_change|round:1}}%" }
    ]
  },
  "size": { "w": 3, "h": 1, "minW": 2, "minH": 1 }
}
