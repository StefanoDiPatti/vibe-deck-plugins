{
  "name": "dev.to: i più letti",
  "description": "Gli articoli più apprezzati di oggi su dev.to",
  "icon": "code",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://dev.to/api/articles?top=1&per_page=15"
  },
  "every": 1800,
  "show": {
    "label": "DEV.TO",
    "items": "{{.}}",
    "max": 15,
    "item": {
      "title": "{{item.title}}",
      "sub": "{{item.public_reactions_count}} reazioni · {{item.comments_count}} commenti",
      "right": "{{item.user.name}}"
    }
  },
  "tap": {
    "type": "open_url",
    "url": "{{item.url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
