{
  "name": "Ask HN",
  "description": "Le domande alla community di Hacker News",
  "icon": "link",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://hn.algolia.com/api/v1/search_by_date?tags=ask_hn&numericFilters=points%3E20&hitsPerPage=15"
  },
  "every": 900,
  "show": {
    "label": "ASK HN",
    "items": "{{hits}}",
    "max": 15,
    "item": {
      "title": "{{item.title}}",
      "sub": "{{item.points}} punti · {{item.num_comments|default:0}} commenti · {{item.created_at|ago}}",
      "right": "{{item.author}}"
    }
  },
  "tap": {
    "type": "open_url",
    "url": "https://news.ycombinator.com/item?id={{item.objectID|url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
