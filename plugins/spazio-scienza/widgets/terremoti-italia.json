{
  "name": "Terremoti in Italia",
  "description": "Gli ultimi terremoti in Italia di magnitudo 2+ (INGV)",
  "icon": "target",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://webservices.ingv.it/fdsnws/event/1/query?format=geojson&minmag=2&limit=15&orderby=time"
  },
  "every": 600,
  "show": {
    "label": "TERREMOTI · INGV",
    "items": "{{features}}",
    "max": 15,
    "item": {
      "title": "{{item.properties.place}}",
      "sub": "{{item.properties.time|ago}}",
      "right": "M {{item.properties.mag|round:1}}",
      "bar": "{{item.properties.mag|mul:10}}",
      "warn": 40,
      "hot": 55
    },
    "empty": "Nessun terremoto"
  },
  "tap": {
    "type": "open_url",
    "url": "https://terremoti.ingv.it/event/{{item.properties.eventId|url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
