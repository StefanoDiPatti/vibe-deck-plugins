{
  "name": "Dov'è la ISS",
  "description": "Posizione, altezza e velocità della Stazione Spaziale Internazionale",
  "icon": "globe",
  "shape": "text",
  "source": {
    "type": "http",
    "url": "https://api.wheretheiss.at/v1/satellites/25544"
  },
  "every": 30,
  "show": {
    "label": "STAZIONE SPAZIALE",
    "icon": "globe",
    "text": "{{latitude|round:1}}°, {{longitude|round:1}}°",
    "sub": "{{altitude|round}} km · {{velocity|round}} km/h"
  },
  "tap": {
    "type": "open_url",
    "url": "https://www.google.com/maps/search/?api=1&query={{latitude}},{{longitude}}"
  },
  "size": {
    "w": 3,
    "h": 1
  }
}
