{
  "name": "Top podcast in Italia",
  "description": "I 10 podcast più seguiti in Italia",
  "icon": "music",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://rss.marketingtools.apple.com/api/v2/it/podcasts/top/10/podcasts.json"
  },
  "every": 3600,
  "show": {
    "label": "TOP PODCAST · ITALIA",
    "items": "{{feed.results}}",
    "max": 10,
    "item": {
      "icon": "music",
      "title": "{{item.name}}",
      "sub": "{{item.artistName}}"
    }
  },
  "tap": {
    "type": "open_url",
    "url": "{{item.url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
