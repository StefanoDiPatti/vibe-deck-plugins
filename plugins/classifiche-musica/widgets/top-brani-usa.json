{
  "name": "Top brani negli USA",
  "description": "I 10 brani più ascoltati negli Stati Uniti",
  "icon": "music",
  "shape": "list",
  "source": {
    "type": "http",
    "url": "https://rss.marketingtools.apple.com/api/v2/us/music/most-played/10/songs.json"
  },
  "every": 3600,
  "show": {
    "label": "TOP BRANI · USA",
    "items": "{{feed.results}}",
    "max": 10,
    "item": {
      "icon": "music",
      "title": "{{item.name}}",
      "sub": "{{item.artistName}}"
    }
  },
  "tap": {
    "type": "open_url",
    "url": "{{item.url}}"
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  }
}
