{
  "name": "Hacker News",
  "description": "Le notizie in prima pagina, tocco = apri sul PC",
  "icon": "link",
  "shape": "list",
  "source": { "type": "http", "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=20" },
  "every": 600,
  "show": {
    "label": "HACKER NEWS",
    "items": "{{hits}}",
    "max": 20,
    "item": {
      "title": "{{item.title}}",
      "sub": "{{item.points}} punti · {{item.num_comments|default:0}} commenti · {{item.created_at|ago}}",
      "right": "{{item.author}}"
    }
  },
  "tap": { "type": "open_url", "url": "https://news.ycombinator.com/item?id={{item.objectID|url}}" },
  "size": { "w": 3, "h": 3, "minW": 2, "minH": 2 }
}
