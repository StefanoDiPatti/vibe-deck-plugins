{
  "name": "Polveri sottili",
  "description": "PM2.5 e PM10 adesso, in µg/m³ (Open-Meteo)",
  "icon": "cloud",
  "shape": "bars",
  "source": {
    "type": "http",
    "url": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=41.89&longitude=12.49&current=pm10,pm2_5&timezone=auto"
  },
  "every": 1800,
  "show": {
    "label": "POLVERI SOTTILI",
    "rows": [
      {
        "label": "PM2.5",
        "value": "{{current.pm2_5}} µg/m³",
        "bar": "{{current.pm2_5}}",
        "warn": 25,
        "hot": 50
      },
      {
        "label": "PM10",
        "value": "{{current.pm10}} µg/m³",
        "bar": "{{current.pm10}}",
        "warn": 40,
        "hot": 80
      }
    ]
  },
  "size": {
    "w": 2,
    "h": 1
  }
}
